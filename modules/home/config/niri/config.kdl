prefer-no-csd
// ---------- OUTPUTS ----------
// Run `niri msg outputs` to find your exact output name (e.g., eDP-1, HDMI-A-1).
// Your Hyprland config used a wildcard; Niri requires the specific connector name.
output "DP-3" {
    mode "1920x1080@165.003"
    scale 1.0
}

// ---------- STARTUP ----------
spawn-at-startup "noctalia"
// hyprpm is Hyprland-specific and has been removed.

// ---------- ENVIRONMENT ----------
environment {
    XCURSOR_SIZE "24"
    HYPRCURSOR_THEME "McMojave"
    HYPRCURSOR_SIZE "32"
}

// ---------- LAYOUT ----------
// Your Hyprland gaps_out was 5. Niri uses a single `gaps` value.
layout {
    gaps 5

    // Border equivalent (Hyprland active/inactive border colors)
    // Niri uses focus-ring and border. A border is always visible.
    border {
        width 2
        active-color "#ebdbb2"
        inactive-color "#32302f"
    }
    // Disable the default focus-ring since you used a border in Hyprland
    focus-ring {
        off
    }

    // Your Hyprland shadow settings
    shadow {
        on
        softness 4
        spread 3
        color "#ee1a1a1a"
    }

    // Dwindle/master configs do not apply. Niri's scrolling layout is fixed.
    // preset-column-widths can be customized if desired.
}

// ---------- INPUT ----------
input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        natural-scroll
    }
    mouse {
      accel-profile "flat"
    }
    focus-follows-mouse max-scroll-amount="0%"    
}

// ---------- KEYBINDS ----------
// Niri does not load default binds; every bind must be defined here.
// Mod = Super key.
binds {
    Mod+Return { spawn "alacritty"; }
    Mod+W { close-window; }
    Mod+M { spawn "sh" "-c" "command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || niri msg action quit"; }
    Mod+Space { toggle-window-floating; }
    Mod+R { spawn "sh" "-c" "noctalia msg panel-open launcher"; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+L { spawn "noctalia" "msg" "session" "lock"; }
    Mod+P { spawn "noctalia" "msg" "screenshot-fullscreen"; }
    Mod+Shift+S { spawn "noctalia" "msg" "screenshot-region"; }

    // Focus navigation (Hyprland direction keys H/J/K/L)
    // Niri uses columns. Up/Down focus windows within a column.
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+O { toggle-overview; }
    // Workspace switching (Niri dynamic workspaces)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // Scroll through columns (was focus left/right on mouse scroll)
    Mod+WheelScrollDown { focus-column-right; }
    Mod+WheelScrollUp { focus-column-left; }

    // Multimedia keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "ddcutil" "setvcp" "10" "+" "10"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "ddcutil" "setvcp" "10" "-" "10"; }

    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
}


